# ---- Database (PostgreSQL) ----
DATABASE_URL="postgresql://user:password@localhost:5432/eventra?schema=public"

# ---- Auth.js / NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---- Razorpay (use TEST/sandbox keys) ----
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---- Cloudinary (event banners) ----
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---- Email (SMTP - e.g. Resend, Mailtrap, Gmail app password) ----
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="EVENTRA <tickets@eventra.app>"

# ---- App ----
NEXT_PUBLIC_APP_URL="http://localhost:3000"
TICKET_SIGNING_SECRET="replace-with-another-long-random-string"
CRON_SECRET="replace-with-a-random-string"

# Client-side unsigned upload (used by the event banner uploader). Create an
# unsigned upload preset in your Cloudinary dashboard: Settings > Upload.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=""
